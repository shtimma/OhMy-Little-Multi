<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <gradient android:angle="315" android:startColor="@color/btn_mint_start" android:endColor="@color/btn_mint_end" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp"><shape><solid android:color="@color/btn_mint_shadow" /><corners android:radius="22dp" /></shape></item>
            <item android:bottom="5dp"><shape><gradient android:angle="315" android:startColor="@color/btn_mint_start" android:endColor="@color/btn_mint_end" /><corners android:radius="22dp" /></shape></item>
            <item android:top="6dp" android:left="10dp" android:right="50dp" android:bottom="46dp"><shape><solid android:color="@color/btn_gloss" /><corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
</selector>